{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "order-hub": { "ClusterId": "order", "Match": { "Path": "/order-api/hubs/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/order-api" } ] },
      "order": { "ClusterId": "order", "Match": { "Path": "/order-api/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/order-api" } ] },
      "notification": { "ClusterId": "notification", "Match": { "Path": "/notification-api/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/notification-api" } ] },
      "inventory": { "ClusterId": "inventory", "Match": { "Path": "/inventory-api/{**rest}" }, "Transforms": [ { "PathRemovePrefix": "/inventory-api" } ] }
    },
    "Clusters": {
      "order": { "Destinations": { "order": { "Address": "http://order:8080/" } } },
      "notification": { "Destinations": { "notification": { "Address": "http://notification:8080/" } } },
      "inventory": { "Destinations": { "inventory": { "Address": "http://inventory:8080/" } } }
    }
  }
}
