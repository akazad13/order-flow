{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.example.com/events/stock-rejected.v1.json",
  "title": "StockRejected v1",
  "description": "The `message` body of the MassTransit envelope published on the stock-rejected exchange. Nothing was held for the order.",
  "type": "object",
  "required": ["orderId", "customerId", "shortages", "rejectedAt"],
  "additionalProperties": false,
  "properties": {
    "orderId": { "type": "string", "format": "uuid" },
    "customerId": { "type": "string", "minLength": 1 },
    "shortages": {
      "type": "array",
      "minItems": 1,
      "description": "Every line that could not be held. An unknown SKU has available 0.",
      "items": {
        "type": "object",
        "required": ["sku", "requested", "available"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "requested": { "type": "integer", "minimum": 1 },
          "available": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "rejectedAt": { "type": "string", "format": "date-time" }
  }
}
