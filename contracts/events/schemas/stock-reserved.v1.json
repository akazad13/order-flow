{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderflow.example.com/events/stock-reserved.v1.json",
  "title": "StockReserved v1",
  "description": "The `message` body of the MassTransit envelope published on the stock-reserved exchange. Prices are fixed at the moment stock is held.",
  "type": "object",
  "required": ["orderId", "customerId", "lines", "total", "reservedAt"],
  "additionalProperties": false,
  "properties": {
    "orderId": { "type": "string", "format": "uuid" },
    "customerId": { "type": "string", "minLength": 1 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "quantity", "unitPrice"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "$ref": "#/$defs/money" }
        }
      }
    },
    "total": { "$ref": "#/$defs/money" },
    "reservedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)([.][0-9]{1,2})?$",
      "description": "Decimal amount in the shop currency, as a string (MassTransit writes decimals as strings to avoid float rounding). Example: \"62.00\"."
    }
  }
}
