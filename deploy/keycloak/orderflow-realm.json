{
  "realm": "orderflow",
  "displayName": "OrderFlow",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "orderflow-gateway",
      "name": "OrderFlow gateway: logs customers in and keeps their tokens on the server (spec 023, ADR 0012)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ORDERFLOW_GATEWAY_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${ORDERFLOW_WEB_URL}/bff/signin-oidc"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ORDERFLOW_WEB_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "audience orderflow-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orderflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "staff",
        "description": "Shop staff: read, watch and cancel any order on the customer's behalf (spec 015)"
      },
      {
        "name": "admin",
        "description": "Shop admins: set stock and add items (spec 017). Separate from staff."
      }
    ]
  }
}
