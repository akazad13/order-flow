{
  "realm": "orderflow",
  "displayName": "OrderFlow",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "orderflow-web",
      "name": "OrderFlow web app (spec 012, ADR 0008)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5180/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5180",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5180/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience orderflow-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orderflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "staff",
        "description": "Shop staff: read, watch and cancel any order on the customer's behalf (spec 015)"
      }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    },
    {
      "username": "sam",
      "enabled": true,
      "email": "sam@example.com",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Staff",
      "realmRoles": [
        "staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "sam",
          "temporary": false
        }
      ]
    }
  ]
}
