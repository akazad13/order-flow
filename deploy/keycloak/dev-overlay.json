{
  "clients": [
    {
      "clientId": "orderflow-gateway",
      "secret": "orderflow-gateway-dev-secret",
      "redirectUris": [
        "http://localhost:5180/bff/signin-oidc",
        "http://localhost:5173/bff/signin-oidc"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5180/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "orderflow-e2e",
      "name": "E2E tests: sets stock as an admin (spec 017). Dev and CI realm only; never in production.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "orderflow-e2e-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience orderflow-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orderflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    },
    {
      "username": "sam",
      "enabled": true,
      "email": "sam@example.com",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Staff",
      "realmRoles": [
        "staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "sam",
          "temporary": false
        }
      ]
    },
    {
      "username": "ada",
      "enabled": true,
      "email": "ada@example.com",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "realmRoles": [
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "ada",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-orderflow-e2e",
      "enabled": true,
      "serviceAccountClientId": "orderflow-e2e",
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
